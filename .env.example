# MiniLedger Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# For local Docker: postgresql://postgres:postgres@localhost:5432/miniledger?schema=public
# For tests: postgresql://postgres:postgres@localhost:5432/miniledger_test?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=miniledger
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=development-jwt-secret-miniledger-replace-in-production-32bytes
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Uploads (Bonus: Receipt Photos)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# -----------------------------------------------------------------------------
# Mobile Client Configuration (Expo)
# -----------------------------------------------------------------------------
# Local computer IP or localhost (Android emulator uses 10.0.2.2)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
